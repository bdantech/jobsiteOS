# ─── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — safe to expose to the browser>

# SERVER ONLY. Bypasses RLS entirely. Never import into a client component,
# never expose via NEXT_PUBLIC_*, never copy into apps/mobile.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ─── AI (Anthropic) ──────────────────────────────────────────────────────────
# Powers the AI Bar (/api/ai). Model: claude-sonnet-4-6.
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Sends temp passwords on admin user creation, and digests.
# Create at https://resend.com/api-keys. Verify your sending domain first.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="JobsiteOS <no-reply@yourdomain.com>"

# ─── Seed ────────────────────────────────────────────────────────────────────
# Email of the first admin user created by `pnpm seed`.
SEED_ADMIN_EMAIL=admin@yourdomain.com

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The public key must be exposed to the browser to subscribe the service worker.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<vapid public key>
VAPID_PUBLIC_KEY=<same value as above>
VAPID_PRIVATE_KEY=<vapid private key — server only>
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Cron ────────────────────────────────────────────────────────────────────
# Shared secret for Vercel Cron → /api/cron/*. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=<random 64-char hex>

# ─── Mercado worker (apps/worker, deployed on Railway) ───────────────────────
# The web app NEVER ingests Receita/CNO data itself (multi-GB dumps). It only
# triggers the worker: monthly via Vercel Cron (/api/cron/mercado-receita,
# /api/cron/mercado-cno) and on demand from the Ingestões admin page.
#
# WORKER_URL   — base URL of the worker service, no trailing path.
#                Its endpoints are POST /jobs/receita and POST /jobs/cno.
# WORKER_SECRET— bearer token the worker requires on those endpoints. Must be the
#                SAME value configured as WORKER_SECRET on the worker service.
#
# SERVER ONLY, both of them. Never NEXT_PUBLIC_*, never imported by a client
# component: they are read exclusively in src/lib/mercado/worker.ts.
WORKER_URL=https://jobsiteos-worker.up.railway.app
WORKER_SECRET=<random 64-char hex — same value on the worker>

# ─── Jurídico (Prompt 08): callback do Escavador ─────────────────────────────
# Segredo que o Escavador manda no header `Authorization` de
# POST /api/webhooks/escavador. NÃO é o token da API — esse vive só no worker, e
# reusá-lo aqui o publicaria num header que um terceiro pode nos fazer comparar.
#
# MESMO VALOR configurado no worker (ESCAVADOR_CALLBACK_TOKEN): a URL cadastrada no
# painel do Escavador pode apontar para a web ou para o worker, e as duas rotas
# gravam na mesma tabela com a mesma chave de idempotência.
#
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SERVER ONLY. Falha FECHADA: sem esta variável, a rota recusa todo callback.
ESCAVADOR_CALLBACK_TOKEN=<copiado do painel do Escavador — mesmo valor no worker>

# ─── Comunicação (Prompt 05A): webhooks e OAuth ──────────────────────────────
# Nenhum token de CONTA está aqui. O token de envio do WhatsApp
# (`whatsapp_contas`) e os tokens do Gmail (`gmail_contas`) vivem no Supabase
# Vault; o que fica em env é o que é da APLICAÇÃO.
#
# WASENDER_WEBHOOK_SECRET / RESEND_WEBHOOK_SECRET
#   Segredos dos WEBHOOKS de entrada, e são OUTROS segredos — não os tokens de
#   envio. O token de envio é por conta e manda mensagem pelo nosso número;
#   publicá-lo num header que qualquer um pode nos fazer comparar batendo na
#   nossa URL entregaria essa capacidade. Mesma régua do callback do Escavador.
#
#   FALHA FECHADA nos dois: sem a variável, a rota recusa TODO webhook. O efeito
#   de um webhook falso é escrever no ledger em nome de um contato real — e, no
#   caso do Resend, escrever na lista de supressão.
#
#   Gere cada um com:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   MESMO VALOR configurado no worker: a URL cadastrada no painel do provedor
#   pode apontar para a web ou para o worker, e as duas rotas fazem a mesma coisa.
WASENDER_WEBHOOK_SECRET=<random 64-char hex — same value on the worker>
RESEND_WEBHOOK_SECRET=<random 64-char hex — same value on the worker>

# App OAuth do Google, para a conexão do Gmail por usuário. O `redirect_uri`
# cadastrado no console tem de ser exatamente
# https://<seu-dominio>/api/auth/gmail/callback
#
# SERVER ONLY. O refresh token de cada pessoa NUNCA volta ao browser: ele é
# gravado no Vault pelo callback, com service role.
GOOGLE_CLIENT_ID=<client id do app OAuth>
GOOGLE_CLIENT_SECRET=<client secret do app OAuth>

# Push do Gmail (Pub/Sub). O tópico é do worker; aqui fica só o segredo que a
# URL da subscription carrega — é ele que separa um push nosso de um POST
# qualquer em /api/webhooks/gmail.
GOOGLE_PUBSUB_TOKEN=<random 32-char hex>
