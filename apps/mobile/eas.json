{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "9.15.0",
      "environment": "production",
      "channel": "production"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-simulator": {
      "extends": "base",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production-apk": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6817750591",
        "appleTeamId": "MNPY9LF8LR"
      },
      "android": {
        "serviceAccountKeyPath": "./play-sa.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
