{
  "expo": {
    "name": "JobsiteOS",
    "slug": "jobsiteos",
    "owner": "oneos",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jobsiteos",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oneos.jobsiteos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#050E40"
      },
      "package": "com.oneos.jobsiteos",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050E40",
          "image": "./assets/images/splash-dot.png",
          "imageWidth": 22,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#050E40",
            "image": "./assets/images/splash-dot.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1e293f",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O JobsiteOS usa a câmera para fotografar documentos contábeis do sacado e anexá-los à análise de crédito.",
          "photosPermission": "O JobsiteOS acessa suas fotos para anexar documentos contábeis à análise de crédito.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "600f94f0-52ac-4504-806c-c10aabaa5990"
      }
    }
  }
}
