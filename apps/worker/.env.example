# ─────────────────────────────────────────────────────────────────────────────
# @jobsiteos/worker — copie para .env e preencha. NUNCA versione o .env.
# ─────────────────────────────────────────────────────────────────────────────

# Bearer exigido em TODA rota. Gere com: openssl rand -base64 48
# O mesmo valor precisa estar no Vercel (o cron mensal manda esse header).
WORKER_SECRET=

# Postgres DIRETO (porta 5432), NÃO o pooler de transações (6543).
# O worker usa COPY e tabelas TEMP — as duas coisas são estado de sessão, e o
# pooler de transações devolve a conexão a cada statement. Com o pooler, o COPY
# funciona e a tabela TEMP some no statement seguinte.
# postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# Cliente service-role (PostgREST): mercado_ingestoes, eventos e notify().
# A service role ignora RLS. Este valor nunca sai do servidor.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Fontes ──────────────────────────────────────────────────────────────────
# A Receita é SEMPRE a fonte primária. O espelho só entra por decisão humana,
# em "Reexecutar com fallback" na tela de Ingestões — nunca automaticamente.
# A Receita migrou para um share público do Nextcloud. Base do WebDAV; os arquivos
# baixam de {BASE}/{mes}/{arquivo}. O caminho antigo (/dados/cnpj/...) dá 404.
RECEITA_BASE_URL=https://arquivos.receitafederal.gov.br/public.php/webdav
# Token do share público, usado como usuário do Basic-auth (senha vazia).
RECEITA_SHARE_TOKEN=YggdBLfdninEJX9
RECEITA_FALLBACK_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br
# Pasta do mês (YYYY-MM). Em branco = mês corrente.
RECEITA_MES=
# Em quantas partes zipadas cada arquivo grande vem (Empresas0..9, etc).
RECEITA_PARTES=10

CNO_SOURCE_URL=https://arquivos.receitafederal.gov.br/dados/cno/cno.zip

# ─── Execução ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Cache dos downloads. No Railway, monte um volume aqui: sem volume, um restart
# na terceira hora do download recomeça do zero.
DOWNLOAD_DIR=/data/receita

# Retentativas por arquivo, com backoff exponencial espalhado por HORAS
# (15min → 45min → 2h15 → 6h45). O servidor da Receita é lento, não instável:
# repetir de 5 em 5 segundos queima as 5 tentativas em um minuto.
RETRY_TENTATIVAS=5
RETRY_BASE_MS=900000
RETRY_FATOR=3

# NÃO existe variável de limiar de promoção aqui, de propósito. Ele vive na
# tabela app_config (migration 0016, chave 'mercado.promocao_camada'), é escrito
# pela tela da Pirâmide e lido pelo worker direto do banco. Como env var, a
# configuração tinha dois donos: um admin que escolhesse 'somente manual' na UI
# veria a próxima ingestão promover assim mesmo, no valor que estivesse aqui.

# ─── Notificações (notify(), em packages/core/src/server) ────────────────────
# Sem estas, o alerta de ingestão falhou ainda grava a notificação no sino —
# só não faz o push web. Os mesmos valores do apps/web.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@oneos.com.br

# ─── Radar (Prompt 03): integrações externas ─────────────────────────────────
# Todas OPCIONAIS de propósito: sem o secret, o job falha limpo (registra
# erro/sem_dados) em vez de derrubar o boot. Nenhuma chamada paga roda sem
# aprovação de lote.
APOLLO_API_KEY=
APOLLO_WEBHOOK_SECRET=
APOLLO_WEBHOOK_URL=
DIRECTD_API_KEY=
ONEPAY_BI_URL=
ONEPAY_BI_TOKEN=
# Etapa 5 da cascata de domínio (busca web via Anthropic). Opcional.
ANTHROPIC_API_KEY=

# ─── Antecipação (Prompt 04): sync de notas fiscais ──────────────────────────
# NÃO PRECISA DEFINIR NADA AQUI. O sync de NFs usa a MESMA API e o MESMO token do
# sync de clientes: sem estas duas, ele monta
# {ONEPAY_BI_URL}/api/v1/invoices — que é o recurso correto, confirmado — e usa
# ONEPAY_BI_TOKEN.
#
# Defina ONEPAY_NF_URL (URL COMPLETA) apenas se o recurso de NFs viver em outro
# caminho ou em outro host. É o único ponto de ajuste se o endpoint real tiver
# outro nome — não é preciso mexer em código.
ONEPAY_NF_URL=
ONEPAY_NF_TOKEN=

# ─── Fornecedores (Prompt 04l): descoberta de contato ───────────────────────
# Opcionais. Sem a credencial o provedor é PULADO com o motivo registrado e a
# cascata segue nos outros — é a diferença entre "não configurado" e "quebrado",
# e ela aparece no painel de eficácia por fonte.
#
# NUNCA em `fornecedores_config`: essa tabela é lida por `authenticated` para o
# card poder mostrar o custo do clique.
NOVAVIDA_USUARIO=
NOVAVIDA_SENHA=
NOVAVIDA_CLIENTE=
# Places API v1 (searchText). Cobrada por consulta E por faixa de fieldMask —
# o código pede cinco campos fixos, nunca `*`.
GOOGLE_PLACES_API_KEY=

# ─── Jurídico (Prompt 08): Escavador ────────────────────────────────────────
# Opcional pelo mesmo desenho do resto: sem o token, os jobs do Jurídico param com
# "ESCAVADOR_TOKEN não configurado" em vez de falharem com erro de rede.
#
# NUNCA em `juridico_config`: essa tabela é lida por `authenticated` para a tela de
# configurações, e a credencial seria distribuída a todo mundo que tem o módulo.
#
# ESCAVADOR_TOKEN          — Bearer da API v2 (https://api.escavador.com/api/v2).
#                            É ele que GASTA CRÉDITO. Cada resposta traz o header
#                            `Creditos-Utilizados`, gravado em juridico_sync_log.
# ESCAVADOR_CALLBACK_TOKEN — segredo do CALLBACK, e é OUTRO segredo. O painel do
#                            Escavador EMITE este valor junto da configuração de
#                            callback: copie de lá, não gere. Reusar o token da API
#                            aqui o publicaria num lugar que um terceiro pode nos
#                            fazer comparar — e é ele que paga.
#                            A rota aceita em Authorization, X-Escavador-Token,
#                            X-Callback-Token, X-Api-Token, X-Token ou ?token=.
#                            MESMO VALOR em apps/web (o callback pode apontar para
#                            qualquer uma das duas rotas).
ESCAVADOR_TOKEN=
ESCAVADOR_CALLBACK_TOKEN=

# ─── Comunicação (Prompt 05A): os três canos ────────────────────────────────
# NENHUM token de conta está aqui. O token de envio de cada número de WhatsApp
# (`whatsapp_contas.token_secret_id`) e os tokens do Gmail de cada pessoa
# (`gmail_contas.*_secret_id`) vivem no Supabase Vault; o worker os lê com
# `app__segredo_vault`, que só o `service_role` executa. O que fica aqui é o que
# é da APLICAÇÃO — base URL do provedor, segredo de webhook, credencial do app
# OAuth e o remetente.
#
# Todas OPCIONAIS pelo mesmo desenho do resto: sem a credencial o transporte é
# PULADO com o motivo registrado e a fila fica esperando, em vez de falhar. É a
# diferença entre "não configurado" e "quebrado", e ela aparece na tela.

# Base da API do Wasender — SÓ o host, sem caminho: o cliente concatena
# `/api/send-message`. Sem ela o envio de WhatsApp fica indisponível MESMO com o
# token de cada número cadastrado no Vault: são duas faltas diferentes, e a fila
# agora diz qual das duas aconteceu.
WASENDER_BASE_URL=https://wasenderapi.com
# Segredo do WEBHOOK de entrada, e é OUTRO segredo — não o token de envio. O de
# envio é POR CONTA e manda mensagem pelo nosso número; publicá-lo num header que
# qualquer um pode nos fazer comparar batendo na nossa URL entregaria isso.
# FALHA FECHADA: sem ele, nenhum webhook entra.
# MESMO VALOR em apps/web (a URL cadastrada no painel pode apontar para as duas).
WASENDER_WEBHOOK_SECRET=

# App OAuth do Google, para o Gmail por usuário. O refresh token de cada pessoa
# vai para o Vault no callback da web; aqui eles servem para RENOVAR o access
# token antes de cada envio e de cada sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tópico do Pub/Sub do Gmail Watch. Sem ele, o recebimento roda só por varredura
# (10 em 10 min) — funciona, mas com atraso.
GOOGLE_PUBSUB_TOPIC=

# Resend: o e-mail do SISTEMA e da IA, de domínio próprio.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# "ONE OS <contato@oneos.com.br>"
RESEND_REMETENTE=
# O remetente da IA, em SUBDOMÍNIO DEDICADO. Volume de máquina e e-mail escrito à
# mão não dividem reputação: quando um queima, o outro cai junto.
RESEND_REMETENTE_IA=

# A conta de WhatsApp do PLANTÃO interno (§1.5). Ausente, o worker usa a primeira
# conta com `tipo = 'plantao'`. Alerta interno não passa por warmup, supressão,
# janela nem teto — e sai por um número que não é o de mercado, para não gastar o
# teto de mercado com mensagem que não é de mercado.
PLANTAO_WHATSAPP_CONTA_ID=

# Base pública da web. Usada para montar o link de descadastro anexado a todo
# e-mail para contato sem aceite explícito em formulário.
APP_BASE_URL=
